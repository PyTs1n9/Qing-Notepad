{
  "name": "qing-notepad",
  "private": true,
  "version": "0.7.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "node scripts/tauri-with-cleanup.mjs",
    "collab:dev": "npm --prefix collab-server run dev",
    "collab:build": "npm --prefix collab-server run build",
    "version:set": "node scripts/set-version.mjs",
    "verify:batch2": "node scripts/verify-batch2/build.mjs --run",
    "verify:batch3": "node scripts/verify-batch3/audit.mjs",
    "verify:batch3:probe": "node scripts/verify-batch3/wasm-eval-probe.mjs",
    "verify:batch4": "node scripts/verify-batch4/run.mjs",
    "verify:plugin-runtime": "node scripts/verify-plugin-runtime/run.mjs",
    "verify:plugin-e2e": "node scripts/verify-plugin-e2e/run.mjs",
    "verify:plugin-snippet": "node scripts/verify-plugin-snippet.mjs",
    "verify:plugin-note-tree": "node scripts/verify-plugin-note-tree.mjs",
    "verify:ui-polish": "node scripts/verify-ui-polish.mjs && node scripts/verify-contrast.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.1",
    "@hocuspocus/provider": "^4.4.0",
    "@huggingface/transformers": "^4.3.1",
    "@supabase/supabase-js": "^2.110.7",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-deep-link": "~2.6.2",
    "@tauri-apps/plugin-dialog": "~2.8.3",
    "@tauri-apps/plugin-fs": "~2.7.1",
    "@tauri-apps/plugin-global-shortcut": "~2.4.1",
    "@tauri-apps/plugin-http": "~2.8.3",
    "@tauri-apps/plugin-opener": "~2.7.2",
    "@tiptap/extension-color": "^3.26.1",
    "@tiptap/extension-font-family": "^3.26.1",
    "@tiptap/extension-highlight": "^3.26.1",
    "@tiptap/extension-image": "^3.26.1",
    "@tiptap/extension-placeholder": "^3.26.1",
    "@tiptap/extension-task-item": "^3.26.1",
    "@tiptap/extension-task-list": "^3.26.1",
    "@tiptap/extension-text-align": "^3.26.1",
    "@tiptap/extension-text-style": "^3.26.1",
    "@tiptap/extension-underline": "^3.26.1",
    "@tiptap/pm": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "codemirror": "^6.0.2",
    "docx": "^9.13.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.18.0",
    "marked": "^18.0.5",
    "motion": "^14.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "semver": "^6.3.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "y-codemirror.next": "^0.3.5",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.31",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "~2.12.4",
    "@types/node": "^25.9.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
