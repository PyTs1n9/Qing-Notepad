# Dependencies and build output
node_modules
dist
dist-ssr

# …except the example plugins' entry points: `examples/qing-wordcount-ts`
# declares `main: ./dist/extension.js`, and the example is only useful if it
# can be installed straight from a checkout.
!examples/*/dist/
!examples/*/dist/**

# Environment files (the tracked template is .env.example)
.env
.env.local
.env.*.local
*.local

# Local application data (single source of truth lives beside the app, never in git)
/data/

# Machine-local build environment (copy env.example.ps1 to env.ps1)
env.ps1

